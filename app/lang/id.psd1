    'sys.deliveryopt.title'   = 'Berbagi update ke PC lain (Delivery Optimization)'
    'sys.deliveryopt.desc'    = 'Windows berhenti meng-upload update ke PC lain di internet/jaringan.'
    'sys.deliveryopt.tradeoff'= 'Hemat kuota upload, ping game lebih stabil. Windows Update tetap jalan normal (langsung dari server Microsoft).'
    'sys.edgebg.title'        = 'Edge Startup Boost & jalan di latar belakang'
    'sys.edgebg.desc'         = 'Edge tidak lagi dimuat diam-diam saat booting dan benar-benar berhenti saat ditutup.'
    'sys.edgebg.tradeoff'     = 'Hemat RAM. Edge sedikit lebih lama di pembukaan pertama.'
    'sys.mapsbroker.title'    = 'Downloaded Maps Manager'
    'sys.mapsbroker.desc'     = 'Service untuk peta offline aplikasi Maps.'
    'sys.mapsbroker.tradeoff' = 'Hanya berpengaruh kalau kamu pakai peta offline Windows.'
    'sys.spooler.title'       = 'Print Spooler (printer)'
    'sys.spooler.desc'        = 'Service untuk semua printer, termasuk "Microsoft Print to PDF".'
    'sys.spooler.tradeoff'    = 'Tidak bisa mencetak dan "Print to PDF" ikut mati. "Save as PDF" di Chrome/Edge/Opera tetap jalan.'
    'sys.faststartup.title'   = 'Fast Startup'
    'sys.faststartup.desc'    = 'Shutdown jadi "bersih": driver dan Windows benar-benar dimuat ulang.'
    'sys.faststartup.tradeoff'= 'Booting ~3-5 detik lebih lama. Bagus untuk dual-boot dan masalah driver yang hilang setelah restart.'
    'sys.sysmain.title'       = 'SysMain (Superfetch)'
    'sys.sysmain.desc'        = 'Windows berhenti memuat aplikasi ke RAM di latar belakang.'
    'sys.sysmain.tradeoff'    = 'Mengurangi aktivitas disk/RAM di latar. Aplikasi yang jarang dibuka mungkin sedikit lebih lambat terbuka (di SSD hampir tidak terasa).'
    'sys.bgapps.title'        = 'Aplikasi Store di latar belakang'
    'sys.bgapps.desc'         = 'Aplikasi Microsoft Store tidak boleh jalan di latar belakang. Discord, Steam, Chrome, dll. TIDAK terpengaruh.'
    'sys.bgapps.tradeoff'     = 'Notifikasi dari aplikasi Store (mis. WhatsApp versi Store) bisa telat.'
    'sys.bluetooth.title'     = 'Matikan Bluetooth sepenuhnya'
    'sys.bluetooth.desc'      = 'Adapter Bluetooth dan semua service Bluetooth dimatikan. Wi-Fi tidak terpengaruh.'
    'sys.bluetooth.tradeoff'  = 'Headset/mouse/controller Bluetooth tidak bisa dipakai sampai dikembalikan. Di Device Manager adapter akan tampil "Error / dinonaktifkan" - itu normal.'
    'sys.browserbg.title'     = 'Browser tetap jalan setelah ditutup'
    'sys.browserbg.desc'      = 'Terdeteksi: {0}. Browser ini bisa terus jalan di latar belakang setelah jendelanya ditutup.'
    'sys.browserbg.tradeoff'  = 'Matikan sendiri di setting browser: cari "Continue running background apps" (Chrome) atau opsi serupa (Opera).'

