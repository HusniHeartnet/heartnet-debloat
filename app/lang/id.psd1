    # ---------------------------------------------------------------- startup (dinamis)
    'startup.edge.title'      = 'Microsoft Edge berjalan diam-diam saat login'
    'startup.edge.desc'       = 'Edge membuka dirinya sendiri di belakang setiap kali kamu login, meskipun tidak dipakai.'
    'startup.edge.tradeoff'   = 'Booting lebih ringan. Edge tetap bisa dibuka normal, hanya sedikit lebih lama di pembukaan pertama.'
    'startup.assistant.title' = 'Asisten browser: {0}'
    'startup.assistant.desc'  = 'Program pendamping browser yang jalan terus di latar belakang (bukan browsernya).'
    'startup.assistant.tradeoff' = 'Browser tetap jalan normal.'
    'startup.generic.title'   = 'Startup: {0}'
    'startup.generic.desc'    = '"{0}" ikut jalan saat Windows nyala.'
    'startup.generic.tradeoff'= 'Booting lebih ringan. Aplikasinya tetap ada dan bisa dibuka manual, hanya tidak auto-start.'
    'od.startup.title'        = 'Startup: OneDrive'
    'od.startup.desc'         = 'OneDrive ikut jalan saat Windows nyala untuk sinkron file.'
    'od.startup.tradeoff'     = 'Hemat RAM dan internet. Tapi file kamu tidak disinkron/di-backup selama OneDrive tidak dibuka.'

    # ---------------------------------------------------------------- peringatan (dinamis)
    'warn.kfm.title'          = 'File kamu tidak ter-backup ke OneDrive'
    'warn.kfm.desc'           = 'Folder {0} ada di dalam OneDrive, tapi OneDrive tidak berjalan dan tidak ikut startup. Perubahan file tidak disinkron.'
    'warn.kfm.tradeoff'       = 'Pilih salah satu: nyalakan lagi OneDrive (Task Manager > Startup apps > OneDrive > Enable), atau pindahkan folder keluar dari OneDrive.'
    'warn.otheruser.title'    = 'Scan berjalan dengan akun admin yang berbeda'
    'warn.otheruser.desc'     = 'App berjalan sebagai {0}, tapi yang sedang login adalah {1}. Setting per-user (aplikasi bawaan, startup, iklan) yang terbaca adalah milik {0}, bukan milikmu.'
    'warn.otheruser.tradeoff' = 'Untuk hasil yang benar, login dengan akun yang mau dibereskan. Kalau akun itu bukan admin, jalankan scan tanpa admin.'
    'warn.wupolicy.title'     = 'Windows Update dimatikan lewat policy'
    'warn.wupolicy.desc'      = 'Ada policy NoAutoUpdate=1. Biasanya dibuat oleh tool debloat lain.'
    'warn.wupolicy.tradeoff'  = 'PC tidak mendapat update keamanan. Heartnet Debloat tidak pernah mematikan Windows Update. Sebaiknya policy ini dihapus.'
    'warn.defpolicy.title'    = 'Microsoft Defender dimatikan lewat policy'
    'warn.defpolicy.desc'     = 'Ada policy DisableAntiSpyware/DisableRealtimeMonitoring. Biasanya dibuat oleh tool debloat lain.'
    'warn.defpolicy.tradeoff' = 'Kalau tidak ada antivirus lain, PC tidak terlindungi.'
    'warn.wusvc.title'        = 'Service Windows Update dimatikan'
    'warn.wusvc.desc'         = 'Service wuauserv berstatus Disabled.'
    'warn.wusvc.tradeoff'     = 'PC tidak mendapat update keamanan. Kembalikan ke Manual.'

    # ---------------------------------------------------------------- software pabrikan
    'oem.lenovo.udc.title'    = 'Lenovo UDC ("NotifyMe")'
    'oem.lenovo.udc.desc'     = 'Service Lenovo untuk notifikasi promo, telemetri, dan pemasangan otomatis aplikasi Lenovo.'
    'oem.lenovo.udc.tradeoff' = 'Laptop tetap normal. Yang hilang hanya notifikasi/promo Lenovo.'
    'oem.lenovo.vantage.title'    = 'Lenovo Vantage'
    'oem.lenovo.vantage.desc'     = 'Aplikasi + service + jadwal tugas Lenovo Vantage (update driver, setting baterai, mode performa).'
    'oem.lenovo.vantage.tradeoff' = 'Atur dulu Conservation Mode/setting baterai sebelum menghapus. Update driver lewat situs Lenovo. Bisa dipasang lagi dari Store.'
    'oem.lenovo.imcontroller.title'    = 'Lenovo System Interface Foundation (ImController)'
    'oem.lenovo.imcontroller.desc'     = '"Mesin" yang memasang ulang add-in Vantage. Tanpa Vantage biasanya tidak dibutuhkan.'
    'oem.lenovo.imcontroller.tradeoff' = 'Di beberapa model, tombol Fn tertentu bisa ikut tidak jalan. Setelah restart, tes Fn+Q, volume, brightness, dan lampu keyboard.'
    'oem.lenovo.lenovonow.title'       = 'Lenovo Now'
    'oem.lenovo.lenovonow.desc'        = 'Aplikasi promosi/rekomendasi Lenovo.'
    'oem.lenovo.lenovonow.tradeoff'    = 'Tidak ada fungsi laptop yang hilang.'
    'oem.lenovo.avatarmaster.title'    = 'Lenovo AvatarMaster'
    'oem.lenovo.avatarmaster.desc'     = 'Aplikasi avatar/efek kamera bawaan Lenovo.'
    'oem.lenovo.avatarmaster.tradeoff' = 'Kamera tetap jalan normal.'
    'oem.lenovo.legionarena.title'     = 'Legion Arena'
    'oem.lenovo.legionarena.desc'      = 'Launcher game Lenovo. Uninstaller-nya perlu diklik manual.'
    'oem.lenovo.legionarena.tradeoff'  = 'Game di Steam/Epic tidak terpengaruh.'
    'oem.nahimic.title'       = 'Nahimic (audio enhancer)'
    'oem.nahimic.desc'        = 'Service, 2 jadwal tugas (NahimicTask32/64), dan aplikasi Nahimic. Driver audio TIDAK disentuh.'
    'oem.nahimic.tradeoff'    = 'Speaker/headset tetap normal, hanya efek "enhancer" yang hilang. Nahimic juga sering bikin masalah audio/overlay di game.'
    'oem.inventory.title'     = 'Software {0} lain di PC ini'
    'oem.inventory.desc'      = '{1}'
    'oem.inventory.tradeoff'  = 'Hanya info. Belum ada aturan yang teruji untuk item ini, jadi Heartnet Debloat tidak mengubahnya.'
    'av.mcafee.leftovers.title'    = 'Sisa McAfee'
    'av.mcafee.leftovers.desc'     = 'Program McAfee sudah tidak ada, tapi jadwal tugas dan/atau folder ProgramData-nya masih tertinggal.'
    'av.mcafee.leftovers.tradeoff' = 'Tidak ada efek. Folder dipindah ke backup, tidak dihapus.'
    'av.installed.title'      = '{0} masih terpasang'
    'av.installed.desc'       = 'Antivirus pra-instal dari pabrikan. Kalau tidak dipakai, uninstall lewat Settings > Apps, lalu jalankan tool pembersih resmi dari vendornya.'
    'av.installed.tradeoff'   = 'Setelah dihapus, Microsoft Defender otomatis aktif. Heartnet Debloat tidak meng-uninstall antivirus.'
    'office.c2r.title'        = 'Microsoft 365 / Office bawaan pabrik'
    'office.c2r.desc'         = 'Terpasang: {0}. Kalau tidak dipakai (misalnya hanya trial), uninstall lewat Settings > Apps.'
    'office.c2r.tradeoff'     = 'Uninstall otomatis Office sering gagal (error 17002/30038), jadi app ini tidak mencobanya. Kalau Settings gagal, pakai tool resmi Microsoft: aka.ms/SaRA-OfficeUninstallFromPC'

    # ---------------------------------------------------------------- Xbox
    'xbox.bgrecord.title'     = 'Rekaman latar "Record what happened"'
    'xbox.bgrecord.desc'      = 'Game Bar merekam layar terus-menerus saat main game supaya bisa menyimpan 30 detik terakhir.'
    'xbox.bgrecord.tradeoff'  = 'Sedikit menambah FPS/mengurangi beban GPU. Tombol "rekam yang barusan" tidak tersedia.'
    'xbox.all.title'          = 'Aplikasi & service Xbox'
    'xbox.all.desc'           = 'Aplikasi Xbox, Game Bar, overlay, service Xbox Live (login, cloud save), dan Game DVR.'
    'xbox.all.tradeoff'       = 'Game Steam/Epic aman. Yang tidak akan jalan: game Microsoft Store/Game Pass dan game yang login pakai akun Xbox. Catatan: XboxGameCallableUI adalah komponen sistem dan tidak bisa dihapus.'
    'xbox.gip.title'          = 'Service controller Xbox (XboxGipSvc)'
    'xbox.gip.desc'           = 'Dipakai controller Xbox untuk update firmware dan Xbox Wireless Adapter.'
    'xbox.gip.tradeoff'       = 'Kalau kamu tidak pernah pakai controller Xbox, aman dimatikan.'

    # ---------------------------------------------------------------- telemetri & privasi
    'tel.services.title'      = 'Service telemetri Microsoft'
    'tel.services.desc'       = 'DiagTrack (Connected User Experiences and Telemetry) dan dmwappushservice.'
    'tel.services.tradeoff'   = 'Data penggunaan tidak dikirim terus-menerus. Tidak ada fitur sehari-hari yang hilang.'
    'tel.level.title'         = 'Data diagnostik ke level minimum'
    'tel.level.desc'          = 'Data diagnostik dikunci di level "Required" dan notifikasi feedback dimatikan.'
    'tel.level.tradeoff'      = 'Tidak ada fitur yang hilang.'
    'tel.tasks.title'         = 'Jadwal tugas pengumpul data'
    'tel.tasks.desc'          = 'CEIP, Disk Diagnostic, Feedback, Error Reporting queue, Autochk proxy, dan MareBackup.'
    'tel.tasks.tradeoff'      = 'Tidak ada fitur yang hilang.'
    'tel.wer.title'           = 'Kirim laporan error ke Microsoft'
    'tel.wer.desc'            = 'Windows berhenti mengirim laporan crash.'
    'tel.wer.tradeoff'        = 'Microsoft tidak menerima data crash dari PC kamu, jadi solusi otomatis untuk crash tertentu tidak muncul.'
    'tel.input.title'         = 'Pengumpulan data ketikan & tulisan tangan'
    'tel.input.desc'          = 'Windows berhenti mengumpulkan pola ketikan dan tulisan tangan untuk "personalisasi".'
    'tel.input.tradeoff'      = 'Prediksi teks keyboard sentuh bisa sedikit kurang pintar.'
    'tel.activity.title'      = 'Riwayat aktivitas (Activity history)'
    'tel.activity.desc'       = 'Windows berhenti mencatat dan mengunggah aktivitas (file/aplikasi yang dibuka).'
    'tel.activity.tradeoff'   = 'Fitur "lanjutkan di PC lain" tidak tersedia.'
    'tel.feedback.title'      = 'Pertanyaan feedback Windows'
    'tel.feedback.desc'       = 'Popup "How likely are you to recommend Windows..." dimatikan.'
    'tel.feedback.tradeoff'   = 'Tidak ada fitur yang hilang.'
    'tel.speech.title'        = 'Daftar bahasa & online speech recognition'
    'tel.speech.desc'         = 'Situs web tidak diberi daftar bahasa kamu. Pengenalan suara online dimatikan.'
    'tel.speech.tradeoff'     = 'Voice typing (Win+H) versi online tidak jalan.'

